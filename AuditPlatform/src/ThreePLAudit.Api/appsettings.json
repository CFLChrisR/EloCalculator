{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Audit": "Data Source=audit.db"
  },
  "Audit": {
    "AutoDisputeMinConfidence": 0.9,
    "AutoDisputeMinAmount": 25,
    "QuantityTolerancePercent": 2,
    "MotorCarrierDisputeDays": 180,
    "ParcelClaimWindowDays": 15
  }
}
